{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "testing/**/*.ts",
    "router/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec-helpers.ts"
  ]
}
